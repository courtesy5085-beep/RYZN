# ─── RYNZ Environment Variables ───────────────────────────────────────────────
# Copy this file to .streamlit/secrets.toml for Streamlit Cloud deployment
# OR use as a .env file for local development

# ─── Supabase ──────────────────────────────────────────────────────────────────
# Get these from: https://app.supabase.com → Project → Settings → API
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...your-anon-key
SUPABASE_SERVICE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...your-service-key

# ─── OpenAI ────────────────────────────────────────────────────────────────────
# Get from: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-proj-...your-openai-api-key

# ─── Streamlit Cloud Secrets Format ───────────────────────────────────────────
# For Streamlit Cloud, create .streamlit/secrets.toml with:
#
# SUPABASE_URL = "https://your-project-id.supabase.co"
# SUPABASE_ANON_KEY = "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."
# SUPABASE_SERVICE_KEY = "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."
# OPENAI_API_KEY = "sk-proj-..."
